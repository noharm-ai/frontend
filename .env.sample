# Copy to .env and fill in. Vite only exposes variables prefixed with VITE_.
#
# WARNING: every value here is inlined into the build output and is therefore
# public. Never put a secret, a password or a personal e-mail address in this
# file.

# --- Required ---
VITE_APP_API_URL=http://localhost:5000       # NoHarm backend base URL
VITE_APP_API_KEY=                            # API gateway key sent as x-api-key

# --- Interface ---
VITE_APP_SITE_TITLE='NoHarm'                 # Browser tab title
VITE_APP_URL=http://localhost:3000           # Public URL of this application
VITE_APP_VERSION=                            # Injected from package.json by CI

# --- Support and external links (optional) ---
VITE_APP_SUPPORT_EMAIL=suporte@example.com   # Support address shown in the UI
VITE_APP_ADMIN_LINK=                         # Link to the administration app
VITE_APP_ODOO_LINK=                          # Link to the support/ERP portal
VITE_MAIL_TEMPLATE_HOST=                     # Base URL for assets in e-mail templates
